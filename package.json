{
  "name": "english-word-cards",
  "version": "1.0.0",
  "private": true,
  "description": "English vocabulary flashcard H5 — Vue3 + Vant (Vite build) frontend, Express + SQLite backend",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist-server/index.js",
    "seed": "tsx server/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vant": "^4.9.15",
    "vite": "^5.4.11",
    "vue": "^3.5.13"
  }
}
